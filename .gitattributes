# Normalise line endings: LF in the repository, whatever the checkout platform.
* text=auto

# Source and docs: always LF, so Linux test builds and Windows VS agree.
*.cs        text
*.md        text
*.props     text
*.targets   text
*.editorconfig text
*.gitignore text
*.yml       text
*.yaml      text
*.json      text

# Visual Studio files that expect CRLF.
*.sln       text eol=crlf
*.csproj    text eol=crlf

# Binary: never touch these.
*.xll       binary
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.snk       binary